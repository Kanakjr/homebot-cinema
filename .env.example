# Copy to your docker-compose / .env and fill in. NEVER commit real values.
# Cloudflare Access (JWT verification). If unset, the server fails closed (503).
CF_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=<application-AUD-tag>[,<second-AUD-if-any>]
# Comma-separated logins that get admin powers
ADMIN_EMAILS=you@example.com
# Name of the profile created for the first/owner login
OWNER_PROFILE_NAME=Owner
# Telegram alerts from Sentinel (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hostnames the browser reaches the app on (comma separated host[:port], optional). The host of each request is always included;
# list extra ones only if the player is opened through a name the request does not carry.
# PUBLIC_HOSTS=cinema.example.com,192.168.1.20:3002
# Optional link to a companion dashboard in the menu and in Settings (https only); hidden when empty
# DASHBOARD_URL=
# Services (docker network names)
STREMIO_SERVER_HOST=stremio-streaming-server
STREMIO_SERVER_PORT=11470
TRANSMISSION_HOST=transmission
TRANSMISSION_PORT=9091
# The Stremio stream addon that Sentinel and the AI copilot ask for downloadable releases, as its base URL or the install link
# (https://<addon>/<optional-config>/manifest.json). There is no built-in default: you choose the source, and without one
# Sentinel and the copilot's "download" find nothing. Use sources you have the right to use.
STREAM_ADDON_URL=
# Media roots as seen inside the container
LIBRARY_MOVIES_DIR=/media/Movies
LIBRARY_TV_DIR=/media/TV
# 0 disables forcing H.264 on HLS transcodes
HLS_FORCE_H264=1
# Smart browse (Browse > Smart filters). Free key from themoviedb.org (Settings > API); v3 key or v4 read token.
# Compose maps CINEMA_TMDB_API_KEY -> TMDB_API_KEY. Leave empty to keep the feature off.
TMDB_API_KEY=
# Optional: override the TMDB API base (default https://api.tmdb.org/3, an official alias of api.themoviedb.org)
# TMDB_API_BASE=
# Two-letter country whose streaming catalogs (Netflix etc.) are searched
WATCH_REGION=IN
# AI copilot (sparkle button in the top bar). Gemini API key from aistudio.google.com. Compose maps GEMINI_API_KEY (shared with
# homebot) and CINEMA_GEMINI_MODEL. Leave empty to keep it off (hidden for everyone except admins, who see a setup hint).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local dev only (NEVER in production): act as this login without Cloudflare
# NODE_ENV=development
# DEV_EMAIL=you@example.com
