# Copy to your docker-compose / .env and fill in. NEVER commit real values.
# Cloudflare Access (JWT verification). If unset, the server fails closed (503).
CF_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=<application-AUD-tag>[,<second-AUD-if-any>]
# Comma-separated logins that get admin powers
ADMIN_EMAILS=you@example.com
# Name of the profile created for the first/owner login
OWNER_PROFILE_NAME=Owner
# Hostnames the browser reaches the app on (comma separated host[:port], optional). The host of each request is always included;
# list extra ones only if the player is opened through a name the request does not carry.
# PUBLIC_HOSTS=cinema.example.com,192.168.1.20:3002
# Optional link to a companion dashboard in the menu and in Settings (https only); hidden when empty
# DASHBOARD_URL=
# Services (docker network names)
STREMIO_SERVER_HOST=stremio-streaming-server
STREMIO_SERVER_PORT=11470
TRANSMISSION_HOST=transmission
TRANSMISSION_PORT=9091
# The Stremio stream addon that Sentinel and the AI copilot ask for downloadable releases, as its base URL or the install link
# (https://<addon>/<optional-config>/manifest.json). There is no built-in default: you choose the source, and without one
# Sentinel and the copilot's "download" find nothing. Use sources you have the right to use.
STREAM_ADDON_URL=
# Media roots as seen inside the container
LIBRARY_MOVIES_DIR=/media/Movies
LIBRARY_TV_DIR=/media/TV
# 0 disables forcing H.264 on HLS transcodes
HLS_FORCE_H264=1
# TMDB (used by the "find" and "ai" plugins). Free key from themoviedb.org (Settings > API); v3 key or v4 read token.
# Leave empty to keep TMDB features off.
TMDB_API_KEY=
# Optional: override the TMDB API base (default https://api.tmdb.org/3, an official alias of api.themoviedb.org)
# TMDB_API_BASE=
# Two-letter country whose streaming catalogs (Netflix etc.) are searched
WATCH_REGION=IN
# ---- Plugins (docs/plugins.md) ----
# Which plugins run: CINEMA_PLUGINS (comma list, "all", "none", "-id" to drop one) > data/plugins.json > each plugin's default
# (find, themes, skip, nowplaying and collections are on by default). Settings below can also live in data/plugins.json under "settings": { "<id>": { ... } }.
# CINEMA_PLUGINS=ai,find,themes,telegram
# Plugin "ai": AI copilot (sparkle button in the top bar). Gemini API key from aistudio.google.com.
# Without a key the plugin stays hidden for everyone except admins, who see a setup hint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Plugin "nowplaying": days of watch history to keep (default 730; 0 = forever)
# NOWPLAYING_KEEP_DAYS=730
# Plugin "mdblist": Rotten Tomatoes (Tomatometer & Audience), Metacritic, IMDb and Letterboxd ratings.
# API key from mdblist.com (Preferences > API). Leave empty to keep plugin inactive.
MDBLIST_API_KEY=
# Plugin "skip": intro/recap/credits times come from chapter markers in your files, then from IntroDB (api.introdb.app).
# "off" keeps every lookup on this machine (chapter markers only).
# SKIP_INTRODB_URL=off
# Plugin "telegram": household alerts (e.g. Sentinel queued a new episode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Plugin "gdrive": cloud folders (rclone mount) as extra library roots, see plugins/gdrive/README.md. Colon-separated paths inside
# the container; add them to MEDIA_ROOTS too so files there can be played.
# LIBRARY_EXTRA_MOVIES_DIRS=/GDriveMovies
# LIBRARY_EXTRA_TV_DIRS=/GDriveTV
# MEDIA_ROOTS=/Movies:/TV:/downloads:/GDriveMovies:/GDriveTV
# TIERING_MIN_AGE_DAYS=14
# TIERING_WATCHED=any
# Plugin "vault": the Locked folder, see plugins/vault/README.md. A folder inside the container that is NOT in MEDIA_ROOTS.
# VAULT_DIR=/Locked
# VAULT_AUTOLOCK_MIN=10
# Local dev only (NEVER in production): act as this login without Cloudflare
# NODE_ENV=development
# DEV_EMAIL=you@example.com
# CINEMA_DATA_DIR=/tmp/cinema-data   # runtime state folder (default ./data)
